# ============================================================================
# CONTOH KONFIGURASI ENVIRONMENT — Choukai_Web backend
#
# PERINGATAN KEAMANAN (BUG-04): nilai contoh lama file ini (password database
# dan auth secret) PERNAH TER-COMMIT ke riwayat git repo ini. Sebelum deploy
# publik, WAJIB dilakukan:
#   1. ROTASI kredensial: ganti password user database di server produksi.
#   2. REGENERASI rahasia: buat BETTER_AUTH_SECRET baru (openssl rand -base64 32).
#   3. Bersihkan riwayat git dengan `git filter-repo` agar rahasia lama tidak
#      bisa dipulihkan dari commit-commit terdahulu.
#
# Semua nilai di bawah adalah placeholder CHANGE_ME / contoh localhost —
# jangan pernah dipakai di produksi apa adanya.
# ============================================================================

# Koneksi database — contoh localhost untuk development.
# Di produksi: isi dengan kredensial nyata yang sudah di-rotate.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/imm_cbt

# Secret penanda tangan session/cookie Better Auth.
# Wajib diisi di produksi (server menolak boot bila kosong saat NODE_ENV=production).
# Tanpa secret di mode dev, server memakai secret EPHEMERAL acak per-proses
# (session tidak survive restart, tetapi cookie tidak bisa dipalsukan dari
# konstanta publik — RESIDUAL BUG-04).
# Generate dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# Kedalaman tier proxy tepercaya untuk resolusi IP rate limiter (RESIDUAL BUG-10).
# 1 = klien→nginx→backend (default, cocok untuk topologi Coolify standar).
# Set 2 bila ada tier proxy tambahan di depan nginx (mis. traefik/Coolify edge):
# klien→traefik→nginx→backend. Tanpa ini, seluruh kelas berbagi satu bucket
# rate-limit → risiko 429 massal saat submit serempak.
TRUSTED_PROXY_COUNT=1

# URL publik aplikasi — contoh localhost untuk development.
BETTER_AUTH_URL=http://localhost:3000

PORT=3000
AUTO_MIGRATE=true
