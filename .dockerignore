.gitignore
.dockerignore
backend/
test_*.js
*.md
*.txt
*.env*
*.log
*.sh
credentials/
*password*

# --- BUG-03 hardening -----------------------------------------------
# data.js (bank soal + KUNCI JAWABAN) tidak boleh pernah terbawa pola
# "COPY ." di stage final Dockerfile. Pengecualian "!data.js" tetap
# diperlukan karena stage-1 (data-sanitizer) membacanya untuk sanitasi;
# stage final memakai COPY eksplisit + guard grep sehingga data.js mentah
# mustahil masuk image (kebocoran apapun = build gagal).
#
# CATATAN RESIDUAL (diluar jangkauan .dockerignore): file ini HANYA mengontrol
# apa yang masuk IMAGE — build CONTEXT yang dikirim ke daemon/builder tetap
# memuat data.js karena stage-1 membutuhkannya. Implikasi:
#   * Jalankan docker build hanya di host/CI terpercaya; untuk eliminasi total
#     dari context gunakan BuildKit secret:
#       docker build --secret id=examdata,src=data.js .
#     dengan Dockerfile alternatif (RUN --mount=type=secret,id=examdata ...).
#   * Hosting statis non-Docker yang menyajikan repo ini secara mentah: JANGAN
#     upload repo mentah — paket aman dibuat OTOMATIS dengan satu perintah:
#       bash scripts/build_static_public.sh   -> dist_static/ (data.public.js +
#       index.html terpatch + snippet nginx 404 untuk /data.js + guard anti-bocor).
data.js
!data.js
# --------------------------------------------------------------------
